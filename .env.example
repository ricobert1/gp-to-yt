# Copy to .env (next to docker-compose.yml) and edit.
# Folder holding the extracted Takeout "Google Photos" videos and sidecars.
STAGING_DIR=/volume1/takeout/Google Photos
# Folders for config + token, and for the database. Create them first (mkdir -p).
CONFIG_DIR=./docker-data/config
DATA_DIR=./docker-data/data
# Your user and group ids (run `id -u` and `id -g`).
PUID=1000
PGID=1000
# Uploads per nightly run.
UPLOAD_LIMIT=5
# 1 = also run `reconcile` in the nightly job.
RECONCILE=0
