paths:
  staging_dir: /path/to/takeout/Google Photos
  db_path: queue.db
  credentials: credentials.json
  token: token.json
  rules: rules.yaml               # playlist rules for `curate` (default: rules.yaml next to this file)
timezone: America/New_York        # local-date rule for recordingDate / playlist rules
youtube:
  privacy: unlisted               # requested; actual may be private (see fact 1)
  category_id: "22"
  made_for_kids: false
  # {title}: Google Photos caption (description's first line), else a meaningful file
  # name, else default_title. Camera names like IMG_1234 / PXL_... are never used.
  # Also: {date} {year} {month} {day} {day_num} {month_name} {month_short}
  #       {weekday} {weekday_short} {time}   (all local time; title max 100 chars)
  # After changing this, run `photos2yt retitle` to update videos not yet uploaded.
  title_template: "{title} – {weekday}, {month_name} {day_num}, {year} {time}"
  default_title: "Family Video"
  upload_chunk_size: 8388608       # bytes; resumable chunk, multiple of 262144 (256 KiB)
  channel_verified: false         # required for videos > 15 min
quota:
  daily_unit_limit: 10000
  upload_cost_units: 1600         # VERIFY against Google's current table
  playlist_insert_cost: 50
  playlist_item_insert_cost: 50
  daily_upload_limit: null        # set if Google uses a separate upload bucket
video_extensions: [.mp4, .mov, .mkv, .m4v, .avi, .3gp]
